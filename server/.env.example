# Base de Datos PostgreSQL
DATABASE_URL="postgresql://usuario:password@127.0.0.1:5432/sig_purple_db?schema=public&connection_limit=25&pool_timeout=30"
DIRECT_URL="postgresql://usuario:password@127.0.0.1:5432/sig_purple_db?schema=public&connection_limit=25&pool_timeout=30"

# Servidor SMTP (Gmail u otro)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="usuario@dominio.com"
SMTP_PASS="app_password_secreta"

# Google Drive (Cuenta de Servicio)
GOOGLE_APPLICATION_CREDENTIALS="./google-credentials.json"
GOOGLE_DRIVE_FOLDER_ID=""

# URL del Frontend
FRONTEND_URL="https://tu-dominio.com"
GEMINI_API_KEY="AIzaSy..."

# Google Calendar OAuth2
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://tu-dominio.com/api/auth/google/callback"

# Seguridad y Autenticación JWT (Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="genera_una_clave_secreta_aleatoria_de_64_caracteres"
